{
  "openapi": "3.1.0",
  "info": {
    "title": "MediSlot API",
    "description": "Clinic appointment and billing system (CSE 3206 Lab 6).",
    "version": "1.0.0"
  },
  "paths": {
    "/patients": {
      "get": {
        "tags": [
          "Patients"
        ],
        "summary": "List Patients",
        "operationId": "list_patients_patients_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Patients"
        ],
        "summary": "Register Patient",
        "operationId": "register_patient_patients_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatientIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/doctors": {
      "get": {
        "tags": [
          "Doctors"
        ],
        "summary": "List Doctors",
        "operationId": "list_doctors_doctors_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Doctors"
        ],
        "summary": "Add Doctor",
        "operationId": "add_doctor_doctors_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DoctorIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/appointments": {
      "get": {
        "tags": [
          "Appointments"
        ],
        "summary": "List Appointments",
        "operationId": "list_appointments_appointments_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Appointments"
        ],
        "summary": "Book",
        "operationId": "book_appointments_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppointmentIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "409": {
            "description": "Slot already booked"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/appointments/{appointment_id}/cancel": {
      "post": {
        "tags": [
          "Appointments"
        ],
        "summary": "Cancel",
        "operationId": "cancel_appointments__appointment_id__cancel_post",
        "parameters": [
          {
            "name": "appointment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Appointment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/invoices": {
      "get": {
        "tags": [
          "Billing"
        ],
        "summary": "List Invoices",
        "operationId": "list_invoices_invoices_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/invoices/{invoice_id}/pay": {
      "post": {
        "tags": [
          "Billing"
        ],
        "summary": "Pay",
        "operationId": "pay_invoices__invoice_id__pay_post",
        "parameters": [
          {
            "name": "invoice_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Invoice Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "402": {
            "description": "Payment declined"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/notifications": {
      "get": {
        "tags": [
          "Notifications"
        ],
        "summary": "Notifications",
        "operationId": "notifications_notifications_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppointmentIn": {
        "properties": {
          "patient_id": {
            "type": "integer",
            "title": "Patient Id",
            "examples": [
              1
            ]
          },
          "doctor_id": {
            "type": "integer",
            "title": "Doctor Id",
            "examples": [
              1
            ]
          },
          "slot": {
            "type": "string",
            "title": "Slot",
            "description": "ISO date-time",
            "examples": [
              "2026-11-05T10:30"
            ]
          }
        },
        "type": "object",
        "required": [
          "patient_id",
          "doctor_id",
          "slot"
        ],
        "title": "AppointmentIn"
      },
      "DoctorIn": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "examples": [
              "Dr. Nasrin Akter"
            ]
          },
          "specialty": {
            "type": "string",
            "title": "Specialty",
            "examples": [
              "Cardiology"
            ]
          },
          "fee": {
            "type": "number",
            "title": "Fee",
            "examples": [
              800
            ]
          }
        },
        "type": "object",
        "required": [
          "name",
          "specialty",
          "fee"
        ],
        "title": "DoctorIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PatientIn": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "examples": [
              "Rahim Uddin"
            ]
          },
          "phone": {
            "type": "string",
            "title": "Phone",
            "examples": [
              "01712345678"
            ]
          },
          "age": {
            "type": "integer",
            "title": "Age",
            "examples": [
              34
            ]
          }
        },
        "type": "object",
        "required": [
          "name",
          "phone",
          "age"
        ],
        "title": "PatientIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "tags": [
    {
      "name": "Patients",
      "description": "Register and list patients"
    },
    {
      "name": "Doctors",
      "description": "Manage doctors and consultation fees"
    },
    {
      "name": "Appointments",
      "description": "Book and cancel time slots"
    },
    {
      "name": "Billing",
      "description": "Invoices and payments via bKash adapter"
    },
    {
      "name": "Notifications",
      "description": "Messages sent to patients"
    }
  ]
}